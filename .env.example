# Skopiuj ten plik do .env i uzupełnij klucz.
#
#   cp .env.example .env
#
# Klucz API Manus. Pobierzesz go z https://manus.im (ustawienia konta → API).
# Czytany WYŁĄCZNIE przez lokalny backend (server/manusApi.ts) w procesie Node.
# Celowo bez przedrostka VITE_: zmienne VITE_* są wstawiane do kodu przeglądarki
# i trafiłyby do każdego, kto otworzy stronę.
MANUS_API_KEY=

# Opcjonalnie: inny adres API (np. środowisko testowe).
# MANUS_BASE_URL=https://api.manus.ai
