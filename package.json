{
  "name": "nodera",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0 --port 3000",
    "build": "tsc && vite build",
    "preview": "vite preview --host 0.0.0.0 --port 3000",
    "lint": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:e2e:report": "playwright show-report e2e-report",
    "fixtures": "node scripts/makeFidelityFont.mjs && node scripts/makeFidelityAssets.mjs"
  },
  "dependencies": {
    "clsx": "^2.1.1",
    "lucide-react": "^1.16.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tailwind-merge": "^2.6.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@tailwindcss/vite": "^4.0.9",
    "@types/jsdom": "^30.0.0",
    "@types/node": "^22.0.0",
    "@types/pngjs": "^6.0.5",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^4.3.4",
    "jsdom": "^30.1.3",
    "pixelmatch": "^8.0.0",
    "pngjs": "^7.0.0",
    "tailwindcss": "^4.0.9",
    "typescript": "^5.7.2",
    "vite": "^6.2.0",
    "vitest": "^3.2.4"
  }
